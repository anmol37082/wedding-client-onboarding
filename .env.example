# Required
MONGODB_URI=mongodb://localhost/jashaneriyasat

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
JWT_SECRET=

# OTP delivery over email. "console" is for local development only and is refused in production.
OTP_PROVIDER=console
# Configure these only when OTP_PROVIDER=smtp.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM=Wedding Staffing <no-reply@example.com>

ADMIN_USERNAME=
ADMIN_PASSWORD=

# Number of trusted reverse-proxy hops; keep 0 for direct/local access.
TRUST_PROXY_HOPS=0
